<web-app>
    <display-name>Application</display-name>
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
        <welcome-file>website.html</welcome-file>
    </welcome-file-list>
    <context-param>
        <param-name>database-url</param-name>
        <param-value>jdbc:mysql://localhost:3306/mydb</param-value>
    </context-param>
    <context-param>
        <param-name>db-ip</param-name>
        <param-value>127.0.0.1</param-value>
    </context-param>
    <servlet>
        <servlet-name>app-servlet</servlet-name>
        <servlet-class>com.application.servlets.AppServlet</servlet-class>

        <init-param>
            <param-name>name</param-name>
            <param-value>ajinkya</param-value>
        </init-param>
        <init-param>
            <param-name>age</param-name>
            <param-value>12</param-value>
        </init-param>
        <init-param>
            <param-name>mail</param-name>
            <param-value>aj@yoooo.com</param-value>
        </init-param>
    </servlet>

    <servlet-mapping>
        <servlet-name>app-servlet</servlet-name>
        <url-pattern>/appservlet</url-pattern>
    </servlet-mapping>
</web-app>